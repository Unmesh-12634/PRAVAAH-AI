# ──── Frontend (Vite / React) ────────────────────────────────────────────────
# Google Maps Platform API Key for Photorealistic 3D Tiles
# Enable "Map Tiles API" in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional Cesium Ion Token (Cesium default world elevation fallback works without token)
VITE_CESIUM_ION_TOKEN=

# ──── Backend / GEE ──────────────────────────────────────────────────────────
GEE_PROJECT_ID=
GEMINI_API_KEY=
DATABASE_URL=
